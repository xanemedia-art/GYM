# ==============================================================================
# GYM MANAGEMENT SAAS — PRODUCTION & VERCEL ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env or configure these variables in the Vercel Project Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connection
# ------------------------------------------------------------------------------
# Transaction or Session pooler URL (e.g. Supabase port 5432 / 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Direct connection URL (used for migrations and schema inspection)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Supabase Client Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[ANON_KEY]"

# ------------------------------------------------------------------------------
# 3. Authentication & Sessions (jose HS256)
# ------------------------------------------------------------------------------
# Minimum 32-character random cryptographic secret
JWT_SECRET="replace-with-at-least-32-char-random-secret-key-2026"

# Public canonical URL of the deployed application (e.g. https://your-gym.vercel.app)
NEXT_PUBLIC_APP_URL="https://your-gym.vercel.app"

# Cookie domain: leave blank or set to your custom domain in production
COOKIE_DOMAIN=""

# ------------------------------------------------------------------------------
# 4. Meta WhatsApp Cloud API (Graph API v20+)
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ------------------------------------------------------------------------------
# 5. Payment Gateways (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. Transactional Email
# ------------------------------------------------------------------------------
EMAIL_FROM="notifications@yourgym.in"
AWS_SES_REGION="ap-south-1"
